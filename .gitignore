node_modules
dist
.DS_Store
.env
youtube-client-secret.json
youtube-token.json
facebook-token.json
wordpress-token.json
pinterest-token.json

# Ignore the output video from Git but not videos you import into src/.
out

# Generated build artifacts from the content pipeline (TTS audio, ffmpeg
# concat lists, timing manifests) — all reproducible by re-running the
# render scripts against the source content JSON, which IS tracked.
public/*/*.mp3
public/*/*.txt
public/*/timings.json
public/*/props.json
public/*/*.props.json

# render-on-this-day-short.mjs, render-motivational-short.mjs, and
# render-global-bharat.mjs (which writes an on-this-day-short-style
# intermediate under a "gb-" prefix) all write a regenerable {audioFile,
# timings} manifest to <date>.json in their OWN output directories —
# unfortunately the exact same filename pattern as the real, hand-
# written content JSON in public/on-this-day/ and public/global-bharat/
# (found 2026-09-10: these manifests were untracked clutter showing up
# in every git status). Scoped to just the manifest-producing dirs, NOT
# on-this-day/ or global-bharat/ themselves, so real content is never
# accidentally matched.
public/on-this-day-short/*.json
public/motivational-short/*.json
public/on-this-day/gb-*.json

# Rendered media inside the review queue — large, regenerable from the
# source scripts, not meant to live in git history. card.json IS tracked
# (see below) since it's the small text/metadata record a cloud-hosted
# scheduled workflow (Bluesky, .github/workflows/bluesky-schedule.yml)
# needs to read to know what's queued for today — this is the ONLY
# reason content-queue stopped being fully gitignored (2026-09-08).
content-queue/**/*.mp4
content-queue/**/*.jpg
content-queue/**/*.jpeg
content-queue/**/*.png
content-queue/archive-data.json
content-queue/analytics-snapshot.json
content-queue/search-console-snapshot.json

# Root-level build outputs from pipeline/build-homepage.mjs (called by
# deploy-homepage.mjs) — regenerated on every homepage sync run, and the
# actual publish target is netlify-deploy/ (Netlify's Git-linked
# directory), not these. Tracking them caused deploy-homepage.mjs's
# `git pull --rebase` step to fail with "unstaged changes" every run
# once they were correctly excluded from that step's `git add
# netlify-deploy/` (found 2026-09-10) — homepage.html (the editable
# SOURCE) remains tracked; only its generated output is ignored here.
homepage.built.html
sitemap.xml
